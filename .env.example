DATABASE_URL=mysql+pymysql://jansetu:jansetu@localhost:3306/jansetu
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
FRONTEND_ORIGIN=http://localhost:5173

# Load schemes.json on startup and publish records that have a verification date
AUTO_SEED_SCHEMES=true

# --- AI chatbot (optional) -------------------------------------------------
# Without a key the chatbot still works in "database answers" mode.
# Free Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Or any OpenAI-compatible API (OpenAI, Groq, OpenRouter, Ollama...):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=

# Max chat messages per IP per 10 minutes
CHAT_RATE_LIMIT=30
